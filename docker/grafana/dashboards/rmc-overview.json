{
  "title": "RMC-Spark Resilience Overview",
  "uid": "rmc-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {
      "type": "timeseries", "title": "Cluster health score H_k",
      "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"min": 0, "max": 1}},
      "targets": [{"expr": "rmc_cluster_health", "legendFormat": "cluster {{cluster}}"}]
    },
    {
      "type": "state-timeline", "title": "Cluster state (0=HEALTHY 1=SUSPECT 2=FAILED)",
      "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "rmc_cluster_state", "legendFormat": "cluster {{cluster}}"}]
    },
    {
      "type": "timeseries", "title": "Alive workers",
      "gridPos": {"x": 0, "y": 8, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"expr": "rmc_cluster_alive_workers", "legendFormat": "cluster {{cluster}}"}]
    },
    {
      "type": "timeseries", "title": "Core utilisation (cores used / cores)",
      "gridPos": {"x": 8, "y": 8, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"min": 0, "max": 1}},
      "targets": [{"expr": "rmc_cluster_utilisation", "legendFormat": "cluster {{cluster}}"}]
    },
    {
      "type": "stat", "title": "Failovers / retries",
      "gridPos": {"x": 16, "y": 8, "w": 8, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"expr": "rmc_failovers_total", "legendFormat": "failovers"},
        {"expr": "rmc_jobs_running", "legendFormat": "jobs running"}
      ]
    },
    {
      "type": "timeseries", "title": "Reliability score R_k",
      "gridPos": {"x": 0, "y": 16, "w": 24, "h": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"min": 0, "max": 1}},
      "targets": [{"expr": "rmc_cluster_reliability", "legendFormat": "cluster {{cluster}}"}]
    }
  ]
}
